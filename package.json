{
  "name": "vigo-video",
  "version": "0.1.0",
  "description": "Lightweight, agent-first video creation and editing. HTML-to-video, JSON timelines, conversions, and MCP.",
  "author": "black-api",
  "homepage": "https://black-api.github.io/vigo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/black-api/vigo.git"
  },
  "bugs": {
    "url": "https://github.com/black-api/vigo/issues"
  },
  "type": "module",
  "bin": {
    "vigo": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "dev": "npm run build && node dist/cli.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "demos": "node scripts/build-demos.mjs",
    "pages": "git push origin main:gh-pages",
    "mcp": "node dist/cli.js mcp"
  },
  "keywords": [
    "video",
    "html-to-video",
    "mcp",
    "ai-agents",
    "ffmpeg",
    "video-editing",
    "deterministic-render",
    "timeline",
    "motion-graphics"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "puppeteer-core": "^24.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
